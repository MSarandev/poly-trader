# polytrader — example environment.
# Copy to `.env` and fill in. NEVER commit a real .env (it holds secrets).
# Placeholders only below.

# ---------------------------------------------------------------------------
# Python client (polytrader) — all optional; these override PolyTraderConfig
# defaults via PolyTraderConfig.from_env(prefix="POLYTRADER_").
# NO secrets belong here — the wallet key lives ONLY in the bridge env below.
# ---------------------------------------------------------------------------
POLYTRADER_BRIDGE_URL=http://localhost:3000
POLYTRADER_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYTRADER_CLOB_API_URL=https://clob.polymarket.com
POLYTRADER_REQUEST_TIMEOUT_S=10
POLYTRADER_MAX_RETRIES=2
POLYTRADER_RETRY_BACKOFF_S=0.25
POLYTRADER_DEFAULT_ORDER_TYPE=FAK
POLYTRADER_DEFAULT_TICK_SIZE=0.01
# Client-side floor for marketable BUYs (Polymarket rejects sub-$1). 0 disables.
POLYTRADER_MIN_MARKETABLE_BUY_USD=1.0
# Treasury (only used when withdraw is enabled client-side).
POLYTRADER_ALLOW_WITHDRAW=false
# Optional: the Polymarket deposit wallet address, surfaced by deposit().
# This is a public "send funds TO here" address, not a secret — leave empty if
# you don't want the package to ship any wallet address.
POLYTRADER_DEPOSIT_ADDRESS=
POLYTRADER_RPC_URL=
POLYTRADER_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
POLYTRADER_CHAIN_ID=137

# ---------------------------------------------------------------------------
# Node CLOB bridge (bridge/index.mjs) — THIS is where the secrets live.
# Do not commit real values. The bridge is the only component that ever sees
# the private key.
# ---------------------------------------------------------------------------
BRIDGE_PORT=3000
CLOB_API_URL=https://clob.polymarket.com

# The EOA that signs orders (deposit-wallet signer). Keep this SECRET.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# The Polymarket funder / API trading wallet (POLY_1271 funder address).
POLYMARKET_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE

# Where the bridge persists derived CLOB API creds (gitignored volume).
CREDS_PATH=/app/creds/api-creds.json

# --- Withdraw (guarded; moves real funds) ---
# Leave false unless you have verified the transfer path on testnet.
BRIDGE_ALLOW_WITHDRAW=false
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
USDC_DECIMALS=6

# NOTE: CLOB API key/secret/passphrase are NOT set here — the bridge derives and
# persists them itself on first boot (createOrDeriveApiKey -> CREDS_PATH).
